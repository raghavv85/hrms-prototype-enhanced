{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/server.js"
    },
    {
      "src": "/(.*)",
      "dest": "/server.js"
    }
  ],
  "env": {
    "NODE_ENV": "production",
    "ENABLE_POSTGRES": "false",
    "JWT_SECRET": "hrms_jwt_secret_key_2024_enhanced_prototype",
    "PORT": "3000"
  }
}
